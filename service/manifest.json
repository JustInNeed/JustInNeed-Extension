{
  "manifest_version": 3,
  "name": "JustInNeed",
  "version": "0.3.0",
  "key": "",
  "description": "읽기 행동 기록 — 글을 읽는 동안 화면 · 스크롤 · 커서 기록을 모은다. 실사용 버전.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JustInNeed 기록",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://api.justinneed.xyz/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://just-in-need-fe.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "js": [
        "vendor/readability.js",
        "content/0-core.js",
        "content/1-stream.js",
        "content/2-units.js",
        "content/3-hittest.js",
        "content/4-input.js",
        "content/5-recorder.js",
        "content/6-frames.js",
        "content/7-observer.js",
        "content/8-overlay.js",
        "content/9-panel.js",
        "content/10-boot.js",
        "content/11-session.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
